# --- planning and design notes -------------------------------------------
# proj-docs/ is the thinking, not the product: 16 plan documents and the
# prototype they were argued out in. Kept local on purpose.
proj-docs/

# --- session data ---------------------------------------------------------
# Every session directory is a sandbox root the agent writes into freely.
# Nothing under here is ever source.
.perpetual/
.sessions/

# --- secrets --------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- build output ---------------------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo
# The desktop build: `stage/` is assembled from the packages on every run and
# `release/` is the installers. Both are outputs. `packaging/` is NOT — it
# holds the icon and the builder config, which are source, and which is why it
# is not called `build/`.
packages/desktop/stage/
packages/desktop/release/

# --- logs and scratch -----------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
.tmp/
tmp/
*.tmp

# --- editor and OS --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
