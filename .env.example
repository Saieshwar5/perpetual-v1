# Copy to .env — it is gitignored, and the controller loads it automatically.
#
# PLACEHOLDERS ONLY. This file is committed; .env is not. A real key pasted
# here is a published key, and rewriting history afterwards does not unpublish
# it — it has to be rotated at the provider.

# Fireworks
PERPETUAL_PROVIDER=fireworks
FIREWORKS_API_KEY=fw_your_key_here
PERPETUAL_MODEL=deepseek-v4-flash-0731

# Anthropic (the default provider; no PERPETUAL_PROVIDER line needed)
# ANTHROPIC_API_KEY=sk-ant-...
# PERPETUAL_MODEL=claude-opus-5

# Optional
# PERPETUAL_EFFORT=low        minimal | low | medium | high | xhigh | max
# PERPETUAL_NET=1             let the sandbox reach the network
