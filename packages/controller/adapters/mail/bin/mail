#!/usr/bin/env python3
"""mail — read Gmail, and draw what comes back.

Runs `gws` directly. There used to be a broker outside the sandbox holding the
credential, back when the sandbox could see neither the disk nor the network;
now that it can see both, that machinery was a wrapper around a CLI the agent
could simply run, so it is gone.

What survives is the part that was always the point: this writes the workspace
view ITSELF. The mapping from a message to a row is stable enough to be code,
and code cannot drift between one session and the next.

Reading only. Writing mail is deliberately not here — see ../tool.md.
"""
import json
import os
import subprocess
import sys
import time
from email.utils import parsedate_to_datetime

APP = "mail"
BODY_LIMIT = 6000
NOTE_LIMIT = 110


def site():
    return os.environ.get("PERPETUAL_SITE") or os.environ.get("HOME") or os.getcwd()


def app_dir():
    d = os.path.join(site(), "ui", "apps", APP)
    os.makedirs(d, exist_ok=True)
    return d


def die(*lines):
    for line in lines:
        print(f"mail: {line}", file=sys.stderr)
    sys.exit(2)


def gws(*args):
    """One read-only gws call, as an argument vector.

    Never a shell string: a subject or a query that happened to contain a
    semicolon would otherwise be a second command. Same rule the workspace
    forms follow for reader-authored values.
    """
    try:
        r = subprocess.run(["gws", *args], capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        die("the `gws` CLI is not installed on this machine.",
            "Say so plainly — there is no other route to the mailbox.")
    except subprocess.TimeoutExpired:
        die("gws did not answer within a minute.")

    if r.returncode != 0:
        why = (r.stderr or r.stdout or f"gws exited {r.returncode}").strip()
        if any(w in why.lower() for w in ("token", "credential", "auth", "login", "expired")):
            die("the Google credential is not working:", why[-400:], "",
                "It may not be visible in this sandbox. Add `gws` to",
                "PERPETUAL_CREDENTIALS and restart the controller.")
        die(*why[-600:].splitlines())
    try:
        return json.loads(r.stdout)
    except ValueError:
        die("gws did not return JSON. Nothing was read.")


def write_view(view, blocks):
    d = app_dir()
    tmp = os.path.join(d, ".view.tmp")
    with open(tmp, "w") as f:
        for b in blocks:
            f.write(json.dumps(b, separators=(",", ":")) + "\n")
    os.replace(tmp, os.path.join(d, "view.ndjson"))
    tmp = os.path.join(d, ".meta.tmp")
    with open(tmp, "w") as f:
        json.dump({"title": "Mail", "view": view}, f)
    os.replace(tmp, os.path.join(d, "meta.json"))


def when(raw):
    """`Fri, 28 Aug 2026 07:47:38 +0530` → `today`. What people actually scan."""
    try:
        ts = parsedate_to_datetime(raw).timestamp()
    except (TypeError, ValueError):
        return raw or ""
    days = (time.time() - ts) / 86400
    if days < 1:
        return time.strftime("%-I:%M %p", time.localtime(ts)).lower()
    if days < 2:
        return "yesterday"
    if days < 7:
        return time.strftime("%a", time.localtime(ts))
    return time.strftime("%-d %b", time.localtime(ts))


def who(sender):
    """`LinkedIn Job Alerts <no-reply@…>` → `LinkedIn Job Alerts`.

    The name, never the address: an inbox is scanned by who it is from, and a
    column of domains is a column nobody reads.
    """
    if isinstance(sender, dict):
        return sender.get("name") or sender.get("email") or "unknown"
    s = str(sender or "").strip()
    if "<" in s:
        name = s.split("<", 1)[0].strip().strip('"')
        return name or s.split("<", 1)[1].rstrip(">")
    return s or "unknown"


def clip(text, n):
    t = " ".join(str(text or "").split())
    return t if len(t) <= n else t[: n - 1] + "…"


def cmd_list(query, max_n):
    data = gws("gmail", "+triage", "--format", "json",
               "--max", str(max_n), "--query", query) or {}
    messages = data.get("messages") or []
    unread = query == "is:unread"

    if not messages:
        what = "unread" if unread else f"matching “{query}”"
        write_view("nothing", [
            {"kind": "heading", "text": f"No {what} mail"},
            {"kind": "prose", "text": "The inbox has nothing to show for that."},
        ])
        print(f"mail: no messages {what}")
        return 0

    items = []
    for m in messages:
        item = {
            "id": str(m.get("id", ""))[:32],
            "title": clip(m.get("subject") or "(no subject)", 120),
            "meta": f"{clip(who(m.get('from')), 40)} · {when(m.get('date'))}",
            "run": f"mail show {m.get('id')}",
        }
        if unread:
            item["state"] = "unread"
        snippet = clip(m.get("snippet"), NOTE_LIMIT)
        # A note that repeats the subject is a row that is harder to read.
        if snippet and snippet.lower() not in item["title"].lower():
            item["note"] = snippet
        items.append(item)

    write_view(f"{len(items)} message{'' if len(items) == 1 else 's'}", [
        {"kind": "rows", "id": "inbox", "items": items},
    ])
    est = data.get("resultSizeEstimate")
    more = f" of about {est}" if isinstance(est, int) and est > len(items) else ""
    print(f"mail: {len(items)} message(s){more}, workspace open")
    return 0


def cmd_show(msg_id):
    m = gws("gmail", "+read", "--id", msg_id, "--headers", "--format", "json") or {}
    subject = m.get("subject") or "(no subject)"
    sender = m.get("from") or {}
    to = m.get("to") or []
    addrs = ", ".join(
        t.get("email", "") if isinstance(t, dict) else str(t) for t in to) or "—"

    frm = sender.get("email", "") if isinstance(sender, dict) else str(sender)
    body = m.get("body_text") or m.get("body_html") or ""

    blocks = [
        {"kind": "heading", "text": clip(subject, 160)},
        {"kind": "fields", "items": [
            {"label": "From", "value": clip(f"{who(sender)} <{frm}>", 120)},
            {"label": "To", "value": clip(addrs, 120)},
            {"label": "Date", "value": str(m.get("date") or "")[:64]},
        ]},
    ]
    text = " ".join(body.split()) if body else ""
    if text:
        # The body is quoted, never obeyed. See the recipe: a message is
        # content written by someone who is not the reader.
        blocks.append({"kind": "prose", "text": clip(body.strip(), BODY_LIMIT)})
    else:
        blocks.append({"kind": "note", "text": "This message has no plain-text body.",
                       "tone": "info"})
    blocks.append({"kind": "rows", "id": "actions", "items": [
        {"id": "back", "title": "Back to the inbox", "meta": "the list you came from",
         "run": "mail list"},
        # No `run`, deliberately: replying is the judgement call, so it asks the
        # agent rather than firing a command.
        {"id": "reply", "title": "Reply to this",
         "meta": "asks the agent to draft one — nothing is sent"},
    ]})
    write_view(clip(subject, 60), blocks)
    print(f"mail: showing {msg_id}")
    return 0


USAGE = """mail — read Gmail, and draw the result in a workspace.

  mail list [--unread|--query Q] [--max N]   the inbox, as a list to pick from
  mail show <id>                             one message, in full

Reading only. There is no send, reply or delete here — see the recipe beside
this program for why, for what the views look like, and for when a mail
question wants a sentence rather than a whole workspace."""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    if argv[0] == "--self-test":
        data = gws("gmail", "+triage", "--format", "json", "--max", "1")
        n = len((data or {}).get("messages") or [])
        print(f"mail: ok — gws answered ({n} message read)")
        return 0

    cmd, rest = argv[0], argv[1:]
    if cmd == "list":
        query, max_n = "is:unread", 20
        i = 0
        while i < len(rest):
            a = rest[i]
            if a == "--unread":
                query = "is:unread"
            elif a == "--query" and i + 1 < len(rest):
                i += 1
                query = rest[i]
            elif a == "--max" and i + 1 < len(rest):
                i += 1
                if not rest[i].isdigit():
                    die("--max takes a number.")
                max_n = min(50, max(1, int(rest[i])))
            else:
                die(f"do not understand `{a}`.", "", *USAGE.splitlines())
            i += 1
        return cmd_list(query, max_n)
    if cmd == "show" and len(rest) == 1:
        return cmd_show(rest[0])
    die(f"do not understand `{' '.join(argv)}`.", "", *USAGE.splitlines())


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
