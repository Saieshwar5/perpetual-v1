{
  "name": "@perpetual/controller",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./paths": "./src/paths.ts",
    "./shell/tool": "./src/shell/tool.ts",
    "./shell/sandbox": "./src/shell/sandbox.ts"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --env-file-if-exists=../../.env src/cli.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "models": "node --experimental-strip-types src/models.ts",
    "report": "node --experimental-strip-types src/report-cli.ts",
    "blocks": "node --experimental-strip-types src/blocks-cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@perpetual/shared": "workspace:*"
  }
}
